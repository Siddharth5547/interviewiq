# InterviewIQ Environment Configuration Template

# Server & Client URLs (Development defaults)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Client (Vite)
VITE_API_URL=http://localhost:5000/api

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/interviewiq
DATABASE_URL=mongodb://127.0.0.1:27017/interviewiq

# Auth Secrets
JWT_SECRET=interviewiq_super_secret_jwt_key_2026_production
SESSION_SECRET=interviewiq_session_secret_key_2026

# Google OAuth Credentials
# In Google Cloud Console:
# Authorized JavaScript Origins: http://localhost:5173, https://your-production-domain.vercel.app
# Authorized Redirect URIs: http://localhost:5000/api/auth/oauth/google/callback, https://your-backend-domain.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

# Apple Sign-In Credentials
# In Apple Developer Portal:
# Services ID: com.interviewiq.auth
# Primary App ID: com.interviewiq.app
# Redirect URI: http://localhost:5000/api/auth/oauth/apple/callback, https://your-backend-domain.com/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=com.interviewiq.service
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/apple/callback

# Optional AI Providers (xai | openai | gemini)
AI_PROVIDER=xai
AI_MODEL=grok-beta
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

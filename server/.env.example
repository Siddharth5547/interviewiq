# App / Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Aliases
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database (Falls back automatically to dual in-memory store if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/interviewiq
DATABASE_URL=mongodb://127.0.0.1:27017/interviewiq

# Auth
JWT_SECRET=interviewiq_super_secret_jwt_key_2026_production
SESSION_SECRET=interviewiq_session_secret_key_2026

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

# Apple Sign-In (Optional)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/apple/callback

# AI Provider (Supported: xai | openai | gemini | omit for built-in Semantic NLP)
AI_PROVIDER=xai
AI_MODEL=grok-beta
XAI_API_KEY=

# Optional alternative AI provider keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Voice (uses browser Web Speech STT/TTS with voice interruption fallback)
VOICE_PROVIDER=web-speech
VOICE_API_KEY=
ELEVENLABS_API_KEY=

# Job / Internship Data Source (Opportunities module)
JOB_API_PROVIDER=adzuna
JOB_API_KEY=
JOB_API_APP_ID=
JOB_API_BASE_URL=https://api.adzuna.com/v1/api

# Transactional Email (Password reset, opportunity alerts)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=notifications@interviewiq.ai

# Caching / Rate Limiting (Optional)
REDIS_URL=

# Monitoring / Error Tracking (Optional)
SENTRY_DSN=

# Primary AI Provider Config (Server-Side Only)
# Supported AI_PROVIDER values: xai | openai | gemini
XAI_API_KEY=
AI_PROVIDER=xai
AI_MODEL=grok-beta

# Optional alternative AI provider keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database Configuration (Falls back automatically to in-memory store if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/interviewiq

# Security & Authentication
JWT_SECRET=interviewiq_super_secret_jwt_key_2026_production

# Real OAuth Provider Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Public URLs & Routing
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
